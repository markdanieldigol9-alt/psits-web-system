{
  "name": "psits-web-system",
  "private": true,
  "scripts": {
    "preapi:dev": "node scripts/ensure-port-free.mjs 3000",
    "preapi:watch": "node scripts/ensure-port-free.mjs 3000",
    "api:dev": "node server/index.js",
    "api:watch": "nodemon server/index.js",
    "api:migrate": "node server/migrate.js",
    "smoke:login": "node scripts/smoke-login.mjs",
    "web:dev": "npm --prefix PSITS run dev",
    "lint": "eslint server/",
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run api:watch\" \"npm run web:dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^5.5.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^8.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.6"
  }
}
